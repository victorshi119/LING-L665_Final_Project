@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/cp-dysarthria/doc/arxiv_1811.11101> a ex:SourceDocument ;
    rdfs:label "Learning to detect dysarthria from raw speech" ;
    dcterms:date "2018" ;
    dcterms:identifier "arxiv_1811.11101" ;
    dcterms:license "http://arxiv.org/licenses/nonexclusive-distrib/1.0/" ;
    dcterms:source <http://arxiv.org/abs/1811.11101v2> .

<http://example.org/cp-dysarthria/stmt/0a05d340c07092c7> a rdf:Statement ;
    ex:entitySource "domain_ner" ;
    ex:evidence "Most of the enrolled individuals with dysarthria showed articulatory imprecision, pneumophonic coordination deficit and harsh voice." ;
    ex:extractor "spacy" ;
    ex:modality "" ;
    ex:polarity "positive" ;
    rdf:object <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/harsh-voice> ;
    rdf:predicate ex:has_feature ;
    rdf:subject <http://example.org/cp-dysarthria/entity/DISORDER/dysarthria> ;
    prov:wasDerivedFrom <http://example.org/cp-dysarthria/doc/pubmed_33190131> .

<http://example.org/cp-dysarthria/stmt/0d91cfcf9d2aa357> a rdf:Statement ;
    ex:entitySource "domain_ner" ;
    ex:evidence "The mel-spectrogram X is encoded into 2-dimensional dysarthria latent space l = {l1, l2} and then used as a conditioning variable for estimating the probability of dysarthria d ∽ p(d|X, θ) and reconstructing the melspectrogram Y ∽ p(Y |X, T, θ)." ;
    ex:extractor "spacy" ;
    ex:modality "" ;
    ex:polarity "positive" ;
    rdf:object <http://example.org/cp-dysarthria/entity/DISORDER/dysarthria> ;
    rdf:predicate ex:applied_to ;
    rdf:subject <http://example.org/cp-dysarthria/entity/SPEECH_TECH/mel-spectrogram> ;
    prov:wasDerivedFrom <http://example.org/cp-dysarthria/doc/arxiv_1907.04743> .

<http://example.org/cp-dysarthria/stmt/1540fad918b5a0f6> a rdf:Statement ;
    ex:entitySource "domain_ner" ;
    ex:evidence "Mixed dysarthria is characterized by harshness of voice in case of UMN involvement and breathy voice in case of LMN involvement." ;
    ex:extractor "spacy" ;
    ex:modality "" ;
    ex:polarity "positive" ;
    rdf:object <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/breathy-voice> ;
    rdf:predicate ex:has_feature ;
    rdf:subject <http://example.org/cp-dysarthria/entity/DISORDER/mixed-dysarthria> ;
    prov:wasDerivedFrom <http://example.org/cp-dysarthria/doc/pubmed_29184336> .

<http://example.org/cp-dysarthria/stmt/173df58b74cac99e> a rdf:Statement ;
    ex:entitySource "domain_ner" ;
    ex:evidence "Ataxic dysarthria which affects respiration, phonation, resonance, and articulation tend to place the same excessive stress on all syllables 2." ;
    ex:extractor "spacy" ;
    ex:modality "" ;
    ex:polarity "positive" ;
    rdf:object <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/phonation> ;
    rdf:predicate ex:has_feature ;
    rdf:subject <http://example.org/cp-dysarthria/entity/DISORDER/ataxic-dysarthria> ;
    prov:wasDerivedFrom <http://example.org/cp-dysarthria/doc/pubmed_29184336> .

<http://example.org/cp-dysarthria/stmt/1d2fdff81108dafa> a rdf:Statement ;
    ex:entitySource "domain_ner" ;
    ex:evidence "[5] has applied various different algorithms and its combination for the adaptation of the system based on HMM acoustic modelling technique like Maximum A-posterior Probability (MAP) adaptation for Speaker independent (SI) system and Transition probability matrix (Linear interpolation) for Speaker Dependent (SD) and Speaker Adapted (SA) with 12 PLP coefficients along with velocity and acceleration coefficients forming 39 dimensional acoustic feature vector using UA speech database and concluded " ;
    ex:extractor "spacy" ;
    ex:modality "" ;
    ex:polarity "positive" ;
    rdf:object <http://example.org/cp-dysarthria/entity/DATASET/ua-speech> ;
    rdf:predicate ex:evaluated_on ;
    rdf:subject <http://example.org/cp-dysarthria/entity/SPEECH_TECH/hmm> ;
    prov:wasDerivedFrom <http://example.org/cp-dysarthria/doc/arxiv_1506.02170> .

<http://example.org/cp-dysarthria/stmt/20ff11b18717915c> a rdf:Statement ;
    ex:entitySource "domain_ner" ;
    ex:evidence "Folia Phoniatrica et Logopaedica Pausing and Sentence Stress in Children with Dysarthria due to Cerebral Palsy Anja Kuschmann Anja Lowit Speech and Language Therapy Department, School of Psychological Sciences and Health, University of Strathclyde, Glasgow, UK Keywords Dysarthria · Cerebral palsy · Pausing · Sentence stress · Children Abstract Introduction: Children with dysarthria due to cerebral palsy (CP) can experience problems manipulating intensity, fundamental frequency, and duration to s" ;
    ex:extractor "spacy" ;
    ex:modality "" ;
    ex:polarity "positive" ;
    rdf:object <http://example.org/cp-dysarthria/entity/DISORDER/dysarthria> ;
    rdf:predicate ex:treats ;
    rdf:subject <http://example.org/cp-dysarthria/entity/TREATMENT/speech-and-language-therapy> ;
    prov:wasDerivedFrom <http://example.org/cp-dysarthria/doc/pubmed_32604092> .

<http://example.org/cp-dysarthria/stmt/2c08ef3e166bfd41> a rdf:Statement ;
    ex:entitySource "domain_ner" ;
    ex:evidence "[18] showed smaller vowel space areas in speech of amyotrophic lateral sclerosis patients compared with neurologically normal subjects." ;
    ex:extractor "spacy" ;
    ex:modality "" ;
    ex:polarity "positive" ;
    rdf:object <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/vowel-space-areas> ;
    rdf:predicate ex:has_feature ;
    rdf:subject <http://example.org/cp-dysarthria/entity/DISORDER/amyotrophic-lateral-sclerosis> ;
    prov:wasDerivedFrom <http://example.org/cp-dysarthria/doc/pubmed_29184336> .

