<http://example.org/cp-dysarthria/entity/DISORDER/mixed-dysarthria> a ns1:DISORDER ;
    rdfs:label "Mixed dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/breathy-voice>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/harshness-of-voice> .

<http://example.org/cp-dysarthria/entity/DISORDER/flaccid-dysarthria> a ns1:DISORDER ;
    rdfs:label "Flaccid dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/harsh-voice>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/inspirational-stridency>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/low-volume> .

<http://example.org/cp-dysarthria/entity/DISORDER/hyperkinetic-dysarthria> a ns1:DISORDER ;
    rdfs:label "Hyperkinetic dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/dystonia>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/frequent-pauses>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/harsh-sounding>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/hypernasality>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/lack-of-intelligibility> .

<http://example.org/cp-dysarthria/entity/DISORDER/hypokinetic-dysarthria> a ns1:DISORDER ;
    rdfs:label "Hypokinetic dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/compulsive-repetition-of-syllables>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/hoarse-speech>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/low-volume>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/monoloudness>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/monopitch> .

<http://example.org/cp-dysarthria/entity/DISORDER/spastic-dysarthria> a ns1:DISORDER ;
    rdfs:label "Spastic dysarthria",
        "spastic dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/f0-jitter>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/harshness-of-vocal-quality>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/long-duration-in-phoneme-to-phoneme-transitions>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/pitch-break> .

<http://example.org/cp-dysarthria/entity/DISORDER/extrapyramidal-dysarthria> a ns1:DISORDER ;
    rdfs:label "Extrapyramidal dysarthria",
        "extrapyramidal dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/f0-jitter>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/f0-monotonicity>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/f1-and-f2-transition-rates>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/flatter-f1-and-f2-transition-rates>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/pitch-monotonicity> .

<http://example.org/cp-dysarthria/entity/DISORDER/ataxic-dysarthria> a ns1:DISORDER ;
    rdfs:label "Ataxic dysarthria",
        "ataxic dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/excessive-stress-on-all-syllables>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/f0-break>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/f0-monotonicity>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/increased-pitch-levels>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/pitch-break>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/pronounced-pitch-fluctuations> .

<http://example.org/cp-dysarthria/entity/DISORDER/dysarthria-due-to-cp> a ns1:DISORDER ;
    rdfs:label "dysarthria due to CP" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/hypernasality>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/imprecise-articulation>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/inappropriate-loudness-levels>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/reduced-pitch-variation>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/reduced-vocal-quality>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/shallow-irregular-breathing>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/slower-speech-rate> .

<http://example.org/cp-dysarthria/entity/ASSESSMENT/robertson-dysarthria-profile> a ns1:ASSESSMENT ;
    rdfs:label "Robertson Dysarthria Profile" ;
    ns1:measures <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/articulation>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/diadochokinesis>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/facial-muscles>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/intelligibility>,
