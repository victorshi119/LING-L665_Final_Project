<http://example.org/cp-dysarthria/stmt/0037a01e3f127795> a rdf:Statement ;
    ex:entitySource "llm" ;
    ex:evidence "Insertion, deletion and repetition of phoneme reduce the intelligibility of speech signal." ;
    ex:extractor "llm" ;
    ex:modality "" ;
    ex:polarity "positive" ;
    rdf:object <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/repetition-of-phoneme> ;
    rdf:predicate ex:has_feature ;
    rdf:subject <http://example.org/cp-dysarthria/entity/DISORDER/dysarthria> ;
    prov:wasDerivedFrom <http://example.org/cp-dysarthria/doc/arxiv_1506.02170> .

<http://example.org/cp-dysarthria/stmt/00b43903f9450b70> a rdf:Statement ;
    ex:entitySource "llm" ;
