<http://example.org/cp-dysarthria/entity/DISORDER/flaccid-dysarthria> a ns1:DISORDER ;
    rdfs:label "Flaccid dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/harsh-voice> .

<http://example.org/cp-dysarthria/entity/DISORDER/spastic-dysarthria> a ns1:DISORDER ;
    rdfs:label "Spastic dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/harshness> .

<http://example.org/cp-dysarthria/entity/DISORDER/ataxic-dysarthria> a ns1:DISORDER ;
    rdfs:label "Ataxic dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/articulation>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/phonation> .

<http://example.org/cp-dysarthria/entity/DISORDER/hypokinetic-dysarthria> a ns1:DISORDER ;
    rdfs:label "Hypokinetic dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/monoloudness>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/monopitch> .

<http://example.org/cp-dysarthria/entity/DISORDER/mixed-dysarthria> a ns1:DISORDER ;
    rdfs:label "Mixed dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/breathy-voice>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/harshness> .

