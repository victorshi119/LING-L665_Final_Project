<http://example.org/cp-dysarthria/entity/DISORDER/dysarthria> a ns1:DISORDER ;
    rdfs:label "Dysarthria",
        "dysarthria" ;
    ns1:has_feature <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/harsh-voice>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/intelligibility>,
        <http://example.org/cp-dysarthria/entity/SPEECH_FEATURE/speech-rate> .

